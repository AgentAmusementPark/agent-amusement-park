# Required on a public deployment so verified scorecard links survive restarts.
PARK_SHARE_SECRET=replace-with-at-least-32-random-bytes

# Public containers must leave this false. It exists only for trusted local development.
ALLOW_LOCAL_ADAPTERS=false

# Enable one route when commercial checkout/contact is approved.
CHECKOUT_URL=
SALES_EMAIL=

HOST=127.0.0.1
PORT=4173
